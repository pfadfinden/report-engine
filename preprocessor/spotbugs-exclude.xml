<?xml version="1.0" encoding="UTF-8"?>
<!--
  Findings that predate this check being wired into the build (see pom.xml). Each entry is an
  accepted-for-now finding, not a false positive - mostly PATH_TRAVERSAL_IN/OUT on report-definition
  file paths (acceptable today since report definitions are author-controlled, not untrusted input)
  and minor RV_RETURN_VALUE_IGNORED_BAD_PRACTICE/BC_VACUOUS_INSTANCEOF cleanups. Remove entries here
  as the underlying code gets fixed, rather than adding new ones for newly-introduced findings.
-->
<FindBugsFilter>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.AbstractFollowUpTaskCommand" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Adapter.SqliteMetadataRepository" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Adapter.YamlMetadataReader" />
        <Bug pattern="BC_VACUOUS_INSTANCEOF" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.DefaultCommand" />
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Metadata.ParameterMetadata" />
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Metadata.VersionMetadata" />
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.MetadataIngestService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.MetadataIngestService" />
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.CompileJasperReportsTask" />
        <Bug pattern="BC_VACUOUS_INSTANCEOF" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.CompileJasperReportsTask" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.CompileJasperReportsTask" />
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.CopySourceTask" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.CopySourceTask" />
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownDetailsPublicTask" />
        <Bug pattern="DM_DEFAULT_ENCODING" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownDetailsPublicTask" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownDetailsPublicTask" />
        <Bug pattern="PATH_TRAVERSAL_OUT" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownDetailsPublicTask" />
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownOverviewTask" />
        <Bug pattern="DM_DEFAULT_ENCODING" />
    </Match>
    <Match>
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.GenerateMarkdownOverviewTask" />
        <Bug pattern="PATH_TRAVERSAL_OUT" />
    </Match>
    <Match>
        <!-- Same accepted trust boundary as CompileJasperReportsTask/CopySourceTask above: the
             subreport path comes from report.jrxml under source-dir, which is author-controlled.
             subreportExists() already canonicalizes and confines the result to the report's own
             directory before checking it, but findsecbugs still flags the File(File,String)
             construction itself as the taint sink. -->
        <Class name="de.pfadfinden.report_engine.preprocessor.Tasks.ValidateJasperReportsTask" />
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
</FindBugsFilter>
