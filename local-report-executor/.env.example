# Copy this file to .env for a self-hosted production deployment (see
# ../docker-compose.local-report-executor.prod.yml). In deployed environments, set these as real
# environment variables/secrets instead of shipping a .env file.

PORT=8080
# URL the /download endpoint's signed link points at - must be reachable by the frontend, not by
# end-user browsers (see the trust-model note in ../README.md).
PUBLIC_BASE_URL=http://local-report-executor:8080

# Secret: JDBC URL of the source database reports are filled against, including credentials.
# Never commit a real value.
REPORT_SOURCEDATA_DATABASE_URL=

# Secret: signs the short-lived /download URLs this service hands back. Never commit a real value.
DOWNLOAD_URL_SIGNING_SECRET=

# Secret: shared bearer token the frontend authenticates with. Anyone holding this key can trigger,
# poll, or download *any* execution - this service must sit behind network isolation reachable only
# by the frontend, never on a public or shared network. Never commit a real value.
EXECUTOR_API_KEY=

# Optional: fetch the reports bundle at runtime instead of reading REPORTS_DIR/SHARED_ASSETS_DIR -
# nothing to download or mount at install time. <REPORTS_RELEASE_URL>/reports.zip is cached under
# REPORTS_CACHE_DIR (must be writable; /tmp is a tmpfs in docker-compose.prod.yml) and re-fetched
# once older than REPORTS_CACHE_TTL_MINUTES. The frontend reads reports.db from the same release:
# keep REPORTS_RELEASE_URL, REPORTS_TOKEN and REPORTS_CACHE_TTL_MINUTES identical in both.
REPORTS_RELEASE_URL=
REPORTS_CACHE_DIR=/tmp/reports-cache
REPORTS_CACHE_TTL_MINUTES=60

# Secret: bearer token sent to the release URL (only to that host, not to redirect targets).
# Leave empty if it needs no auth. Never commit a real value.
REPORTS_TOKEN=
