# Test environment for the frontend<->executor e2e suite (see ../playwright.config.ts).
# All values here are throwaway local secrets for a disposable stack -
# never used against anything real. Postgres connection info matches a plain `postgres:16`
# container/service with no special setup beyond POSTGRES_PASSWORD/POSTGRES_DB (see
# .github/workflows/frontend-ci.yaml for the CI service container, or run one yourself, e.g.:
#   docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=test -e POSTGRES_DB=e2e_test postgres:16
PGHOST=localhost
PGPORT=5432
PGDATABASE=e2e_test
PGUSER=postgres
PGPASSWORD=test

E2E_FRONTEND_PORT=3100
E2E_EXECUTOR_PORT=3101
E2E_EXECUTOR_API_KEY=e2e-test-executor-api-key
E2E_DOWNLOAD_SIGNING_SECRET=e2e-test-signing-secret
E2E_SESSION_SECRET=e2e-test-session-secret
