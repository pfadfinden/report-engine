doctype html
html(lang='de')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet', href='/style.css')
  body
    header.site-header
      .metabar
        //- Left-hand slot. Kept (empty) so `justify-content: space-between` pushes
        //- the tab to the right edge exactly as it does on beitritt.pfadfinden.de.
        .metabar_start
        a.metabar_tab(href=memberManagementUrl target='_blank' rel='noopener') Zurück zur MV
      .masthead.container.container--masthead
        a.masthead_brand(href='/')
          img.masthead_logo(src='/klilie-logo.svg', alt='', width='56', height='56')
          span.masthead_wordmark
            strong BdP
            |  Berichte
        if principal
          nav.masthead_nav(aria-label='Benutzerkonto')
            span.masthead_user Angemeldet als #{principal.name}
            a.masthead_link(href='/auth/logout') Abmelden
    #content
      block content
    footer.site-footer
      section.site-footer_top
        .container
          .site-footer_grid
            .site-footer_brand
              img(src='/bdp-logo-full.svg', alt='Bund der Pfadfinder*innen e.V. (BdP)', width='238', height='64')
            address.site-footer_address
              div.site-footer_address_title Bund der Pfadfinder&#42;innen e.V. (BdP)
              div.site-footer_address_title BdP Bundesamt
              div Kesselhaken 23
              div 34376 Immenhausen, DE
              div
                span Telefon:&nbsp;
                a(href='tel:+49 5673 99584-0') +49 5673 99584-0
              div: a(href='mailto:info@pfadfinden.de') info@pfadfinden.de
              div: a(href='https://www.pfadfinden.de' target='_blank' rel='noopener') www.pfadfinden.de
      section.site-footer_wave
        .container.site-footer_wave_inner
          nav.site-footer_legal(aria-label='Footer')
            ul
              li
                a(href='https://www.pfadfinden.de/impressum/' target='_blank' rel='noopener')
                  | Impressum
                  span.site-footer_underline(aria-hidden='true')
              li
                a(href='https://www.pfadfinden.de/datenschutzerklaerung/' target='_blank' rel='noopener')
                  | Datenschutzerklärung
                  span.site-footer_underline.site-footer_underline--wide(aria-hidden='true')
          p.site-footer_credit
            | Ein Service des
            = ' '
            a(href='https://www.pfadfinden.de' target='_blank' rel='noopener') Bund der Pfadfinder&#42;innen e.V. (BdP)
    block scripts
