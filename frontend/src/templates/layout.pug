doctype html
html(lang='de')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet', href='/style.css')
  body
    header.site-header
      .topbar
        a.topbar_tab.topbar_tab--yellow(href=memberManagementUrl target='_blank' rel='noopener') Zurück zur MV
      .masthead
        a.masthead_brand(href='/')
          img.masthead_logo(src='/klilie-logo.svg', alt='', width='40', height='40')
          span.masthead_wordmark
            strong BdP
            |  Berichte
        if principal
          nav.masthead_nav
            span.masthead_user Angemeldet als #{principal.name}
            a(href='/auth/logout') Abmelden
    block content
    footer.site-footer
      section.site-footer_top
        .site-footer_grid
          .site-footer_brand
            img(src='/bdp-logo-full.svg', alt='Bund der Pfadfinder*innen e.V. (BdP)', width='208', height='56')
          address.site-footer_address
            div.site-footer_address_title Bund der Pfadfinder&#42;innen e.V. (BdP)
            div.site-footer_address_title BdP Bundesamt
            div Kesselhaken 23
            div 34376 Immenhausen, DE
            div: span Telefon: #[a(href='tel:+49 5673 99584-0') +49 5673 99584-0]
            div: a(href='mailto:info@pfadfinden.de') info@pfadfinden.de
            div: a(href='https://www.pfadfinden.de' target='_blank' rel='noopener') www.pfadfinden.de
      section.site-footer_bottom
        .site-footer_bottom_inner
          nav.site-footer_legal(aria-label='Footer')
            ul
              li
                a(href='https://www.pfadfinden.de/impressum/' target='_blank' rel='noopener')
                  | Impressum
