extends layout

block content
  -
    var errorTitles = {
      400: 'Fehlerhafte Anfrage',
      404: 'Pfad nicht gefunden',
      401: 'Pfad blockiert',
      403: 'Pfad blockiert',
      429: 'Zu viele Anfragen',
      500: 'Serverfehler',
    };
    var title = errorTitles[status] || 'Fehler';

  .page-hero
    .container
      h1.page-hero_title= title
      span.page-hero_squiggle(aria-hidden='true')
  main
    .container
      .page-content

        .alert.alert--error
          .alert_title Fehler #{status}
          //- The global 404 handler's message matches the title above,
          //- so only repeat it here when it actually adds something.
          if message !== title
            p= message

        //- Only set for a rate-limited report start: replays the submitted form, so nothing
        //- has to be filled in again. Until the window resets it will be refused again.
        if retry
          form.retry(method='POST', action=retry.action)
            each field in retry.fields
              input(type='hidden', name=field.name, value=field.value)
            p.retry_text Du kannst es in etwa #{retry.retryAfterSeconds > 90 ? Math.ceil(retry.retryAfterSeconds / 60) + ' Minuten' : retry.retryAfterSeconds + ' Sekunden'} erneut versuchen.
            button(type='submit') Erneut versuchen

        .actions
          a.btn(href='/') Zur Startseite
          a.btn.btn--secondary(href=memberManagementUrl target='_blank' rel='noopener') Zurück zur MV

        aside
          .w-text
            h3 Das Problem tritt weiterhin auf?
            p Bei anhaltenden Problemen kannst du dich per E-Mail bei #{supportEmail} melden.
            a.btn.btn--secondary(href="mailto:" + supportEmail + "?subject=" + encodeURIComponent('Fehler ' + status + ' auf der Berichtsseite')) Support Ticket öffnen
