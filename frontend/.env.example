# Copy this file to .env for local development.
# In deployed environments, set these as real environment variables/secrets
# instead of shipping a .env file.

# Server
PORT=3000
NODE_ENV=development

# Report metadata source: "local" reads a SQLite file from disk,
# "remote" downloads (and caches) one from a URL.
REPORTS_DB_SOURCE=local

# Used when REPORTS_DB_SOURCE=local
REPORTS_DB_LOCAL_PATH=../dist/preprocessed/reports.db

# Used when REPORTS_DB_SOURCE=remote
REPORTS_DB_REMOTE_URL=https://github.com/pfadfinden/mv_reports/releases/download/v0.0.1/reports.db
# Secret: GitHub PAT with access to the release asset above (only needed for private repos).
# Never commit a real value — set this via your deployment platform's secret store.
REPORTS_DB_AUTH_TOKEN=
REPORTS_DB_CACHE_DIR=.cache/reports-db
REPORTS_DB_CACHE_TTL_MS=1800000

# Groups are resolved against the Hitobito API using roles fetched directly
# from Hitobito's own userinfo endpoint (see OIDC_BROKER_IDP_ALIAS below).
# Base URL of the Hitobito instance, e.g. https://db.example.org (see <base>/api/openapi.yaml)
HITOBITO_API_URL=
# Secret: Hitobito service token (sent as the X-TOKEN header). Never commit a real value.
HITOBITO_API_TOKEN=
# How long resolved groups are cached per principal, so repeated requests
# (e.g. one per page load) don't re-hit the Hitobito API each time.
HITOBITO_GROUPS_CACHE_TTL_MS=300000

# Report execution: base URL of whichever executor implements the shared
# trigger/status/download HTTP API - local-report-executor (Docker) or the
# Azure Functions executor both expose the same contract, so either works.
REPORT_EXECUTION_API_URL=http://localhost:8081
# Secret: local-report-executor always requires this (its own EXECUTOR_API_KEY);
# the Azure Functions executor needs it only if its HTTP triggers use a function
# key. Never commit a real value.
REPORT_EXECUTION_API_TOKEN=
# Whether the browser downloads the finished report directly from the executor's
# signed URL ("direct") or the frontend fetches and streams it itself ("proxy",
# recommended - the executor is then never exposed to the browser/network at
# all, and this is the only place a real per-user authorization check happens).
REPORT_DOWNLOAD_MODE=proxy

# Authentication (OpenID Connect / OAuth 2.0 Authorization Code + PKCE)
# Base URL of the OIDC issuer; "<issuer>/.well-known/openid-configuration" must resolve.
# For Keycloak this is the realm URL, e.g. https://keycloak.example.org/realms/mv-reports
OIDC_ISSUER_URL=
# Only needed when this backend can't reach OIDC_ISSUER_URL's host directly
# (e.g. running in a container where the issuer host means the container
# itself). Rewrites the network destination of outgoing OIDC requests
# without affecting issuer validation. Leave unset in production.
# Format: bare host[:port], no scheme (e.g. "host.docker.internal:7080", not "http://...").
OIDC_BACKEND_HOST=
OIDC_CLIENT_ID=
# Secret: only needed for confidential clients. Never commit a real value.
OIDC_CLIENT_SECRET=
# Alias of the Keycloak identity provider brokering login (e.g. "mv-oidc").
# Used to fetch the external IdP's own roles data directly via Keycloak's
# Identity Brokering API V2.
OIDC_BROKER_IDP_ALIAS=
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
# Secret: random string used to sign the session cookie. Never commit a real value.
AUTH_SESSION_SECRET=
