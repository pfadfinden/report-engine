<!-- Minimal single-table report used as a project-wide test fixture (see report-engine's
     test-fixtures/ directory, referenced by the preprocessor's and local-report-executor's
     integration tests). Sits next to metadata.yaml (report id "members"), _shared/ReportStyles.jrtx
     (external style template, resolved via <template> below) and _shared/logo.png (external image,
     resolved via the pageHeader's image element below) - together they exercise the full report
     pipeline (metadata ingestion, compilation, template/image resolution, SQL execution) against a
     real database without needing a copy of production data. -->
<jasperReport name="members" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f2d4b6a-1c3e-4a9f-9b2d-6e7f1a2b3c4d">
	<template><![CDATA["ReportStyles.jrtx"]]></template>
	<parameter name="p_joined_after" class="java.sql.Date">
		<description><![CDATA[Only include members who joined on or after this date.]]></description>
	</parameter>
	<query language="sql"><![CDATA[SELECT id, first_name, last_name, email, joined_on
FROM members
-- CAST is required here: Postgres can't infer a bind parameter's type from an "IS NULL"
-- comparison alone, and fails the whole query ("could not determine data type of parameter")
-- even though the same parameter is unambiguously typed via its other use below.
WHERE (CAST($P{p_joined_after} AS DATE) IS NULL OR joined_on >= $P{p_joined_after})
ORDER BY last_name, first_name]]></query>
	<field name="id" class="java.lang.Integer"/>
	<field name="first_name" class="java.lang.String"/>
	<field name="last_name" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="joined_on" class="java.sql.Date"/>
	<pageHeader height="70" splitType="Stretch">
		<element kind="image" uuid="1a2b3c4d-5e6f-4a1b-8c2d-3e4f5a6b7c8d" x="0" y="0" width="120" height="40" scaleImage="RetainShape">
			<expression><![CDATA["logo.png"]]></expression>
		</element>
		<element kind="staticText" uuid="2b3c4d5e-6f7a-4b2c-9d3e-4f5a6b7c8d9e" x="0" y="45" width="300" height="25" style="Title">
			<text><![CDATA[Members]]></text>
		</element>
	</pageHeader>
	<columnHeader height="20" splitType="Stretch">
		<element kind="staticText" uuid="3c4d5e6f-7a8b-4c3d-ae4f-5a6b7c8d9e0f" x="0" y="0" width="30" height="16" style="ColumnHeader">
			<text><![CDATA[ID]]></text>
		</element>
		<element kind="staticText" uuid="4d5e6f7a-8b9c-4d4e-bf5a-6b7c8d9e0f1a" x="30" y="0" width="140" height="16" style="ColumnHeader">
			<text><![CDATA[First name]]></text>
		</element>
		<element kind="staticText" uuid="5e6f7a8b-9c0d-4e5f-a06b-7c8d9e0f1a2b" x="170" y="0" width="140" height="16" style="ColumnHeader">
			<text><![CDATA[Last name]]></text>
		</element>
		<element kind="staticText" uuid="6f7a8b9c-0d1e-4f6a-b17c-8d9e0f1a2b3c" x="310" y="0" width="165" height="16" style="ColumnHeader">
			<text><![CDATA[Email]]></text>
		</element>
		<element kind="staticText" uuid="7a8b9c0d-1e2f-4a7b-c28d-9e0f1a2b3c4d" x="475" y="0" width="80" height="16" style="ColumnHeader">
			<text><![CDATA[Joined]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<element kind="textField" uuid="8b9c0d1e-2f3a-4b8c-d39e-0f1a2b3c4d5e" x="0" y="0" width="30" height="16" style="DetailText">
				<expression><![CDATA[$F{id}]]></expression>
			</element>
			<element kind="textField" uuid="9c0d1e2f-3a4b-4c9d-e40f-1a2b3c4d5e6f" x="30" y="0" width="140" height="16" style="DetailText">
				<expression><![CDATA[$F{first_name}]]></expression>
			</element>
			<element kind="textField" uuid="0d1e2f3a-4b5c-4d0e-f51a-2b3c4d5e6f7a" x="170" y="0" width="140" height="16" style="DetailText">
				<expression><![CDATA[$F{last_name}]]></expression>
			</element>
			<element kind="textField" uuid="1e2f3a4b-5c6d-4e1f-a62b-3c4d5e6f7a8b" x="310" y="0" width="165" height="16" style="DetailText">
				<expression><![CDATA[$F{email} == null ? "" : $F{email}]]></expression>
			</element>
			<element kind="textField" uuid="2f3a4b5c-6d7e-4f2a-b73c-4d5e6f7a8b9c" x="475" y="0" width="80" height="16" pattern="dd.MM.yyyy" style="DetailText">
				<expression><![CDATA[$F{joined_on}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="20" splitType="Stretch">
		<element kind="textField" uuid="3a4b5c6d-7e8f-4a3b-c84d-5e6f7a8b9c0d" x="0" y="0" width="300" height="14" style="Footer">
			<expression><![CDATA["members - " + $V{PAGE_NUMBER} + " page(s)"]]></expression>
		</element>
	</pageFooter>
</jasperReport>
